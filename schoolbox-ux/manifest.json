{
  "manifest_version": 3,
  "name": "Schoolbox UX Tweaks",
  "version": "1.2.12",
  "description": "Small UX improvements for staff using Schoolbox.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://my.careywa.au/*",
    "https://my.edval.education/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Schoolbox UX tweaks"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.careywa.au/*"
      ],
      "js": [
        "main-world-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://my.careywa.au/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "tweak-config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://my.careywa.au/learning/assessments/*/status*"
      ],
      "js": [
        "status-limit-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://my.careywa.au/learning/assessments/*/status*"
      ],
      "js": [
        "status-limit-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://my.careywa.au/learning/assessments/*/status*"
      ],
      "js": [
        "status-grid.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://my.careywa.au/learning/markbook/class/*"
      ],
      "js": [
        "markbook-period.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://my.edval.education/timetable*"
      ],
      "js": [
        "edval-scrape.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
